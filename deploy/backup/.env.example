# Копировать в deploy/backup/.env и заполнить реальными значениями.
# .env в этой папке НЕ коммитится (см. корневой .gitignore — правило .env*
# действует и здесь).

# --- База данных ------------------------------------------------------------
# Строка подключения к живой БД (та же, что DATABASE_URL у приложения).
DATABASE_URL=

# --- Шифрование (age) --------------------------------------------------------
# Публичный ключ age (age1...). НЕ секрет — безопасно хранить на сервере и
# в этом файле. Генерируется один раз на СВОЁМ компьютере:
#   age-keygen -o luna-backup-key.txt
# Приватный ключ (AGE-SECRET-KEY-1...) из этого файла НИКОГДА не копируется
# на сервер — см. deploy/backup/README.md, раздел "Где хранить приватный ключ".
AGE_RECIPIENT=

# --- Google Drive (через rclone) ---------------------------------------------
# Имя remote из `rclone config` (см. README) и папка на Google Drive.
RCLONE_REMOTE=gdrive
RCLONE_FOLDER=luna-backups

# --- Хранение копий -----------------------------------------------------------
# Сколько зашифрованных копий держать локально на сервере (в днях).
RETENTION_LOCAL_DAYS=7
# Сколько ежедневных копий держать на Google Drive (штук).
RETENTION_DRIVE_DAILY=30
# Сколько месячных копий (первая копия каждого месяца) держать на Google Drive.
RETENTION_DRIVE_MONTHLY=12

# Локальная папка для зашифрованных копий на сервере.
BACKUP_DIR=/opt/luna/backups

# --- Уведомления об ошибках (Telegram) ---------------------------------------
# Тот же бот и чат, что у приложения — токен бота и chat_id супер-админа.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
