# Copy to .env and fill in real values locally. NEVER commit a file with real
# values — only this file (names, no secrets) is tracked in git.

# --- Database ------------------------------------------------------------
# Postgres connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of extra origins allowed to call the API cross-origin
# (e.g. a separately-hosted frontend, or another admin tool). Same-origin
# browser requests (the normal case — api-server serves the built frontend
# itself) never need this. Leave empty unless you actually have one.
CORS_ALLOWED_ORIGINS=

# --- Clerk (authentication) --------------------------------------------------
# Secret key — server-side only, real secret. From Clerk dashboard → API Keys.
CLERK_SECRET_KEY=
# Publishable key — safe to expose, used server-side for a couple of calls too.
CLERK_PUBLISHABLE_KEY=
# Same publishable key, but read by the frontend build (Vite inlines VITE_* at
# build time, so this must be set wherever `pnpm run build` runs).
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: lets the API verify Clerk session JWTs locally instead of calling
# out to Clerk's JWKS endpoint on every request. This is a PUBLIC key (safe to
# expose), from Clerk dashboard → API Keys → Advanced → JWT verification key.
CLERK_JWT_KEY=
# Optional: only needed if the frontend talks to Clerk through a proxy path
# instead of directly (e.g. api.clerk.com behind your own domain).
VITE_CLERK_PROXY_URL=

# --- Telegram bot (stock/write-off notifications) ---------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Object storage (item photos) -------------------------------------------
# NOTE: these two names come from Replit's Object Storage integration.
# Phase 1 audit checks whether the underlying client also depends on Replit's
# credential sidecar (127.0.0.1:1106) — if so, this needs a real GCS
# service-account setup before it will work on a plain VPS.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
