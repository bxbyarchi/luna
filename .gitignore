# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Secrets — real values never belong in git, only .env.example (names, no values)
.env
.env.*
!.env.example

# DB dumps / backups — may contain real customer & staff PII (see incident 2026-09-27:
# backup_database.sql was committed to this PUBLIC repo and has been purged from history).
# Drizzle migrations (lib/db/drizzle/**/*.sql) are schema, not data — kept tracked.
*.sql
!lib/db/drizzle/**/*.sql
*.dump
*.dump.gz

# Source snapshots / archives that have accidentally ended up committed before
# (project.zip, project_part_aa.., artifacts/m-sklad/public/code_clean.zip)
*.zip
project_part_*
