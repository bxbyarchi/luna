modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 25487
externalPort = 3000

[nix]
channel = "stable-25_05"

# Clerk keys used to be hardcoded here in [userenv.shared]. They are no longer
# read from this file — set them via Replit Secrets (or the deployment
# platform's env vars / a local .env, see .env.example) instead. Even though
# a Clerk publishable key and JWT verification key aren't secret by
# themselves, hardcoding config in a committed file is still the wrong
# pattern, and this file has no effect outside Replit anyway.
[userenv]
